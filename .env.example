# Backend PRD §16 — every key required in production. Placeholders below
# are dev-safe defaults; never copy this file to .env with real secrets
# checked in (.env* is gitignored except this file — see .gitignore).

NODE_ENV=development

# --- Data stores ---
# localhost here is correct for running the api natively on the host
# (against `docker compose up postgres redis`). When the api itself runs
# as a container, docker-compose.yml overrides these to the postgres/redis
# service hostnames — see that file's api.environment block.
DATABASE_URL=postgresql://portfolio:portfolio@localhost:5432/portfolio
REDIS_URL=redis://localhost:6379

# --- Admin auth (§6.1) ---
SESSION_SECRET=dev-only-change-me-to-a-random-32-plus-character-string
ADMIN_EMAIL=admin@example.com

# --- Mail (§3 MailAdapter, §9 contact pipeline) ---
MAIL_PROVIDER=console
MAIL_API_KEY=dev-placeholder
MAIL_FROM_ADDRESS=no-reply@example.com

# --- Origin (§13 CORS, §10.2 OG/absolute URLs) ---
SITE_ORIGIN=http://localhost

# --- Analytics (§10) ---
# Salt for the daily-rotating sessionHash. Not in the original §16 table —
# added because §10 requires the hash to be salted; see packages/types/src/env.ts.
ANALYTICS_SALT=dev-only-change-me-16-plus-chars

# --- Tunable constants (§16, all optional with the defaults shown) ---
CV_GRANT_TTL_DAYS=7
CONTACT_RATE_LIMIT_PER_IP_HOUR=5
CONTACT_RATE_LIMIT_PER_EMAIL_DAY=3
ANALYTICS_RETENTION_DAYS=90

# --- apps/web wiring (M0 — not part of the backend §16 table) ---
# Internal, container-to-container URL (Compose network); proves the API
# is reachable without going through Traefik.
INTERNAL_API_URL=http://api:3001
# Public origin the browser uses (through Traefik); same value as
# SITE_ORIGIN in a single-domain deploy.
NEXT_PUBLIC_SITE_ORIGIN=http://localhost
